#!/bin/sh
# cc-context-telemetry - statusLine entry (the SAFE wrapper). PURE POSIX SHELL.
#
# Claude Code runs this as its statusLine command, with the session JSON on stdin,
# EVERY render. The hot path here is therefore deliberately Node-free: spawning a
# Node process per render (tens of MB, ~100ms) across many concurrent sessions at
# high render frequency piles up load and can take a machine down. So this entry
# does only the minimum, in shell:
#   1. read stdin ONCE into a temp file,
#   2. extract session_id with a bounded sed (fall back to "default"),
#   3. write the RAW payload to telemetry-raw-<session_id>.json (the ONLY write;
#      all JSON parsing happens later, on demand, in the hook/consumer via index.js),
#   4a. WRAP mode (env CCT_WRAP set): EXEC the wrapped command on the SAME stdin so
#       THIS process BECOMES your statusline and Claude Code manages it exactly like
#       a direct statusLine (no spawn, no detach, no babysat orphan), or
#   4b. STANDALONE mode (no CCT_WRAP): print a minimal plain-text bar extracted from
#       the payload in shell (no emoji), then exit 0. Never blank.
#
# WHY EXEC, NOT SPAWN: Claude Code kills the statusline process every render to keep
# it bounded. EXEC makes the wrapped command BE the process Claude Code kills, so it
# is torn down each render exactly as if run directly. No pile-up, no orphan.
set -u

# Capture stdin to a temp file ONCE so both the raw-telemetry write and the EXEC'd
# statusline get the EXACT same bytes.
#
# WHY `cat` CANNOT HANG HERE (evidence, not assumption): a `cat` reading the statusLine
# stdin only blocks if Claude Code never closes that stdin. We have direct evidence it
# DOES close it: the `adtention` statusLine binary's `status` command does
# `io.ReadAll(os.Stdin)`, which blocks until EOF, and it runs FLAT as a DIRECT
# statusLine on every render with no pile-up (owner-confirmed in production). If Claude
# Code did NOT close the statusLine's stdin, that direct `io.ReadAll` would hang EVERY
# render and the renders would pile up - they do not - therefore Claude Code closes the
# statusLine's stdin after its single bounded write. Our `cat` reads the IDENTICAL stdin
# Claude Code hands the statusLine (the wrapper IS the statusLine via exec), so it gets
# the IDENTICAL EOF and returns. We deliberately do NOT add a per-render read timeout or
# a Node guard: that would reintroduce a per-render spawn (the exact pile-up this rewrite
# removes), to "fix" a hang the evidence above shows cannot happen. The test harness
# feeds a closing stdin to exercise this real EOF path.
tmp="$(mktemp 2>/dev/null)" || tmp="${TMPDIR:-/tmp}/cct.$$"
cat > "$tmp"

# Telemetry dir: CCT_DIR override, else ~/.claude/cc-context-telemetry. Mirror
# index.js telemetryDir(). HOME may be unset in odd environments; tolerate it.
dir="${CCT_DIR:-${HOME:-/tmp}/.claude/cc-context-telemetry}"

# Extract the TOP-LEVEL "session_id" string in pure shell. Bounded: a single
# non-greedy sed over one line of the (small) payload. Sanitize to [A-Za-z0-9_-] so a
# hostile id cannot escape the dir, then mirror index.js sanitizeId so a reader
# resolves the same filename: every char outside [A-Za-z0-9_-] becomes "_", and an
# empty result falls back to "default" (NOT "shared" - the JS reader's empty-id
# fallback is "default"; they must agree or a hook read would miss the file). For a
# real session_id (an ASCII UUID: hex + hyphens) shell `tr` (byte-wise) and JS regex
# (code-unit) agree EXACTLY. An exotic non-ASCII id may map to a different name in the
# two (tr counts bytes, JS counts UTF-16 units), but BOTH stay contained inside the
# dir - the worst case is a fail-safe read-miss, never a path escape.
sid="$(sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$tmp" 2>/dev/null | head -n 1)"
sid="$(printf '%s' "$sid" | tr -c 'A-Za-z0-9_-' '_' )"
[ -n "$sid" ] || sid="default"

# Write the RAW payload for on-demand parsing by the consumer. Per session, so the
# file count is bounded by live sessions (the reader prunes stale ones, see
# index.js). Best-effort: a failed mkdir/write must never break the bar.
#
# ATOMIC: write to a temp file IN THE SAME DIR, then `mv` (rename) over the final
# name. POSIX rename within a filesystem is atomic, so a concurrent on-demand reader
# sees either the old complete file or the new complete file, never a half-written
# one. (cp alone writes in place and a reader could catch a partial file; the reader
# tolerates that by returning null on a parse error, but the atomic rename removes
# the race entirely.) The temp uses $$ so concurrent renders for the SAME session do
# not clobber each other's temp; the final rename is last-writer-wins, which is
# correct (newest render's payload wins).
mkdir -p "$dir" 2>/dev/null || true
raw_final="$dir/telemetry-raw-$sid.json"
raw_tmp="$dir/.telemetry-raw-$sid.$$.tmp"
if cp "$tmp" "$raw_tmp" 2>/dev/null; then
  mv -f "$raw_tmp" "$raw_final" 2>/dev/null || rm -f "$raw_tmp" 2>/dev/null || true
fi

# Build the telemetry SEGMENT: "ctx X% | 5h Y% ~cd | 7d Z% ~cd" in cheap pure shell.
# Shown PREPENDED in WRAP mode and as the whole bar in STANDALONE. No emoji (project rule).
# Never blank. Cosmetic and fail-soft; the AUTHORITATIVE parse is index.js (real JSON.parse).
#
# ctx (context %) is PER SESSION: it comes only from THIS render's payload ($tmp).
#
# 5h/7d are ACCOUNT-WIDE, but Claude Code refreshes rate_limits only on an API call, so a
# single session's payload is often stale and different open sessions disagree. To show ONE
# coherent number we pick the FRESHEST reading for each window across ALL sessions'
# telemetry-raw-*.json files (plus this render's payload): the reading with the largest
# PLAUSIBLE resets_at (a window's reset boundary only moves forward), tie-broken by the
# largest used_percentage (usage only grows within one window period). A non-epoch or
# corrupt far-future resets_at is rejected so it cannot win. If NO reading carries a
# resets_at (older Claude Code, or a synthetic payload) we fall back to THIS session's own
# usage with no countdown. The countdown() logic is UNCHANGED; it just runs on the freshest
# resets_at.
#
# now comes from CCT_NOW when set (a deterministic test seam, unused in production) else
# `date +%s`; countdown is a pure DURATION so no timezone math. Bounded: ONE awk over (this
# payload + the per-session raw files, whose count the reader prunes). No Node, no per-render
# spawn beyond this single synchronous awk.
now="${CCT_NOW:-$(date +%s 2>/dev/null)}"
case "$now" in ""|*[!0-9]*) now="" ;; esac

# Which segments to show, and in what ORDER (CCT_SEGMENTS, comma or space separated).
# Tokens: ctx, 5h, 7d, model. Order = display order; presence = shown. Unknown tokens are
# ignored; unset or empty falls back to the default. This is the only knob for the layout.
segs="${CCT_SEGMENTS:-ctx,5h,7d,model}"

# The account-wide pool: every session's raw file ON THIS MACHINE (one CCT_DIR; this does
# not converge across devices). Safe glob (if none match, pass none), then DROP any
# unreadable or non-regular entry: pure awk FATALS on a file it cannot open, which would
# blank the WHOLE segment (losing even this session's ctx). We read foreign per-session
# files we did not create this render, so a leftover root-owned file, a dangling symlink, or
# a directory matching the glob must be skipped, not fatal. The positional list is CLEARED
# after the awk (before the WRAP exec) so CCT_WRAP never inherits these paths as its argv.
set -- "$dir"/telemetry-raw-*.json
[ -e "$1" ] || set --
n=$#
while [ "$n" -gt 0 ]; do
  f=$1; shift
  [ -f "$f" ] && [ -r "$f" ] && set -- "$@" "$f"
  n=$((n - 1))
done

# $tmp (this render's payload) is passed FIRST and identified by name (-v tmpf), so ctx and
# the per-session fallback usage always come from THIS session even if another session's
# file sorts first; $tmp also joins the pool (a failed raw-write still contributes it).
# LC_ALL=C makes awk byte-wise: the model-id whitelist deterministically strips ALL
# non-ASCII/high bytes (incl. the C1 0x80-0x9f range) across every awk and locale, and
# number parsing uses a "." decimal regardless of the user's locale.
seg="$(LC_ALL=C awk -v now="$now" -v tmpf="$tmp" -v segs="$segs" '
  # Text INSIDE key'"'"'s object, via a running brace-depth count. Assumes the real schema
  # (window objects hold only numbers, no braces in string values); a stray brace only makes
  # this COSMETIC segment omit/truncate a field (never injects), and index.js is authoritative.
  function objspan(key,   p, i, n, depth, start, c) {
    p = index(J, "\"" key "\"")
    if (p == 0) return ""
    n = length(J); i = p
    while (i <= n && substr(J, i, 1) != "{") i++
    if (i > n) return ""
    start = i; depth = 0
    while (i <= n) {
      c = substr(J, i, 1)
      if (c == "{") depth++
      else if (c == "}") { depth--; if (depth == 0) return substr(J, start + 1, i - start - 1) }
      i++
    }
    return ""
  }
  function up(key,   t) {
    t = objspan(key)
    if (t == "") return ""
    gsub(/\{[^{}]*\}/, "", t)
    if (match(t, /"used_percentage"[ \t]*:[ \t]*[0-9]+(\.[0-9]+)?/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*:[ \t]*/, "", t); return t
  }
  function resetsat(key,   t) {
    t = objspan(key)
    if (t == "") return ""
    gsub(/\{[^{}]*\}/, "", t)
    if (match(t, /"resets_at"[ \t]*:[ \t]*[0-9]+/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*:[ \t]*/, "", t); return t
  }
  function rnd(v) { if (v == "") return ""; return int(v + 0.5) }
  # The model id STRING (e.g. "claude-opus-4-8[1m]") from the model object. Unlike every
  # other field this is display text, not a number, so it is SANITIZED before it can reach
  # the terminal (strip control chars = defuse ANSI/escape injection from a hostile payload;
  # strip spaces and "|" so a weird id cannot break the segment layout). Absent -> "".
  function modelid(   t) {
    t = objspan("model")
    if (t == "") return ""
    if (match(t, /"id"[ \t]*:[ \t]*"[^"]*"/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*"id"[ \t]*:[ \t]*"/, "", t); sub(/".*/, "", t)
    gsub(/[^]A-Za-z0-9._[-]/, "", t)   # WHITELIST: only safe display chars survive (strips
    return t                            # ANSI/ESC and any control byte, plus spaces/"|"/"%")
  }
  # Short friendly model token: drop the "claude-" prefix and dot the version (a digit-
  # hyphen-digit becomes digit-dot-digit), so claude-opus-4-8[1m] -> opus-4.8[1m],
  # claude-fable-5 -> fable-5. General rule, no per-model lookup table.
  function friendlymodel(   m) {
    m = modelid()
    if (m == "") return ""
    sub(/^claude-/, "", m)
    while (match(m, /[0-9]-[0-9]/)) m = substr(m, 1, RSTART) "." substr(m, RSTART + 2)
    return m
  }
  # Compact "~time-left" from an absolute reset epoch (UNCHANGED). Two units max; trailing
  # unit shown only when non-zero; "~<1m" under a minute, "~now" at or past reset. Omits
  # when now/resets_at missing, resets_at is not a plausible epoch (< 1e9), or the gap
  # exceeds the window horizon maxsec.
  function countdown(rsat, maxsec,   sec, d, h, m) {
    if (rsat == "" || now == "") return ""
    if (rsat + 0 < 1000000000) return ""
    sec = rsat - now
    if (sec > maxsec) return ""
    if (sec <= 0) return "~now"
    if (sec < 60) return "~<1m"
    if (sec < 3600) return "~" int(sec/60) "m"
    if (sec < 86400) { h = int(sec/3600); m = int((sec%3600)/60); return (m == 0) ? ("~" h "h") : ("~" h "h" m "m") }
    d = int(sec/86400); h = int((sec%86400)/3600); return (h == 0) ? ("~" d "d") : ("~" d "d" h "h")
  }
  # Rank one file'"'"'s reading of a window into the account-wide freshest: keep the max
  # PLAUSIBLE resets_at (within the window horizon), tie-broken by max used_percentage.
  function consider(win, maxsec, reset, usage,   r) {
    if (reset == "" || usage == "") return
    r = reset + 0
    if (r < 1e9 || r >= 1e11) return                    # not a plausible seconds-epoch
    if (now != "" && r > now + maxsec) return           # corrupt far-future for this window
    if (win == 5) { if (!h5 || r > r5 || (r == r5 && usage + 0 > u5 + 0)) { r5 = r; u5 = usage; h5 = 1 } }
    else          { if (!h7 || r > r7 || (r == r7 && usage + 0 > u7 + 0)) { r7 = r; u7 = usage; h7 = 1 } }
  }
  function flush() {                                    # J holds one complete file'"'"'s payload
    consider(5, 21600, resetsat("five_hour"), up("five_hour"))
    consider(7, 691200, resetsat("seven_day"), up("seven_day"))
    if (curfile == tmpf) Jtmp = J                       # remember THIS session for ctx + fallback
    J = ""
  }
  FNR == 1 { if (NR > 1) flush(); curfile = FILENAME }
  { J = J $0 }
  END {
    flush()
    J = Jtmp                                            # per-session values from THIS payload only
    ctx = rnd(up("context_window")); f5 = rnd(up("five_hour")); f7 = rnd(up("seven_day"))
    # Render each segment string once ("" = nothing to show for it). Cross-session ranked
    # value only when now is known (else consider()'"'"'s far-future guard is off) - else fall
    # back to THIS session'"'"'s own usage with no countdown.
    ctxseg = (ctx == "") ? "ctx --" : ("ctx " ctx "%")
    if (now != "" && h5) { fivehseg = "5h " rnd(u5) "%"; cd = countdown(r5, 21600); if (cd != "") fivehseg = fivehseg " " cd }
    else if (f5 != "")   { fivehseg = "5h " f5 "%" }
    if (now != "" && h7) { sevendseg = "7d " rnd(u7) "%"; cd = countdown(r7, 691200); if (cd != "") sevendseg = sevendseg " " cd }
    else if (f7 != "")   { sevendseg = "7d " f7 "%" }
    modelseg = friendlymodel()
    # Assemble in the CCT_SEGMENTS order, joining the present segments with " | ".
    k = split(segs, arr, /[ ,]+/)
    out = ""
    for (i = 1; i <= k; i++) {
      p = ""
      if (arr[i] == "ctx") p = ctxseg
      else if (arr[i] == "5h") p = fivehseg
      else if (arr[i] == "7d") p = sevendseg
      else if (arr[i] == "model") p = modelseg
      if (p != "") out = (out == "") ? p : (out " | " p)
    }
    printf "%s", out
  }
' "$tmp" "$@" 2>/dev/null)"
[ -n "$seg" ] || seg="ctx --"

# Clear the positional params (the account-wide file pool) so the CCT_WRAP command below,
# run via `eval exec`, does NOT inherit these file paths as its argv ($@ / $1 / $#).
set --

# WRAP mode: PRINT our telemetry segment, then EXEC the wrapped statusline so its bar
# appends on the SAME line ("ctx 66% | 5h 12% | 7d 30% <wrapped bar>"). Printing BEFORE
# exec preserves the no-orphan property: the wrapped command still BECOMES the process
# Claude Code kills (no spawn, no detach, no per-render Node). The segment is emitted
# from a subshell so its bytes are FLUSHED to stdout before exec hands the fd to the
# wrapped command (a plain builtin printf can sit in the shell output buffer that exec
# would discard). That subshell is one cheap, synchronously-reaped fork, like the awk
# calls above - not a lingering process.
#
# We do NOT route through `sh -c "$CCT_WRAP"` (which may FORK and leave an orphan on a
# per-render kill), and we NEVER detach. Do NOT background your statusLine with a
# trailing `&`: a statusLine that backgrounds a helper outliving the front pid leaks it
# on every render-kill - IDENTICALLY under direct use and under this wrapper (exec makes
# the wrapped command BECOME the killed process, so the tree matches direct; the leak is
# the forking statusline's own foot-gun, not the wrapper's). test/loadrepro proves this
# (forking callee run both ways: FDIR == FWRP).
if [ -n "${CCT_WRAP:-}" ] && [ -n "$(printf '%s' "${CCT_WRAP:-}" | tr -d '[:space:]')" ]; then
  ( printf '%s ' "$seg" )
  exec 3< "$tmp"
  rm -f "$tmp"
  # `eval` parses a quoted command string ("'/path/adtention' status"); `exec` replaces
  # THIS shell with it so it becomes the killed process. A missing command exits 127
  # (the segment still printed); we NEVER spawn a fallback.
  eval "exec ${CCT_WRAP} <&3"
  exit 0
fi

# STANDALONE mode (no CCT_WRAP): the telemetry segment IS the whole bar.
rm -f "$tmp"
printf '%s' "$seg"
exit 0
