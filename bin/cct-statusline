#!/bin/sh
# cc-context-telemetry - statusLine entry (the SAFE wrapper). PURE POSIX SHELL.
#
# Claude Code runs this as its statusLine command, with the session JSON on stdin,
# EVERY render. The hot path here is therefore deliberately Node-free: spawning a
# Node process per render (tens of MB, ~100ms) across many concurrent sessions at
# high render frequency piles up load and can take a machine down. So this entry
# does only the minimum, in shell:
#   1. read stdin ONCE into a temp file,
#   2. extract session_id with a bounded sed (fall back to "default"),
#   3. write the RAW payload to telemetry-raw-<session_id>.json (the ONLY write;
#      all JSON parsing happens later, on demand, in the hook/consumer via index.js),
#   4a. WRAP mode (env CCT_WRAP set): EXEC the wrapped command on the SAME stdin so
#       THIS process BECOMES your statusline and Claude Code manages it exactly like
#       a direct statusLine (no spawn, no detach, no babysat orphan), or
#   4b. STANDALONE mode (no CCT_WRAP): print a minimal plain-text bar extracted from
#       the payload in shell (no emoji), then exit 0. Never blank.
#
# WHY EXEC, NOT SPAWN: Claude Code kills the statusline process every render to keep
# it bounded. EXEC makes the wrapped command BE the process Claude Code kills, so it
# is torn down each render exactly as if run directly. No pile-up, no orphan.
set -u

# Capture stdin to a temp file ONCE so both the raw-telemetry write and the EXEC'd
# statusline get the EXACT same bytes.
#
# WHY `cat` CANNOT HANG HERE (evidence, not assumption): a `cat` reading the statusLine
# stdin only blocks if Claude Code never closes that stdin. We have direct evidence it
# DOES close it: the `adtention` statusLine binary's `status` command does
# `io.ReadAll(os.Stdin)`, which blocks until EOF, and it runs FLAT as a DIRECT
# statusLine on every render with no pile-up (owner-confirmed in production). If Claude
# Code did NOT close the statusLine's stdin, that direct `io.ReadAll` would hang EVERY
# render and the renders would pile up - they do not - therefore Claude Code closes the
# statusLine's stdin after its single bounded write. Our `cat` reads the IDENTICAL stdin
# Claude Code hands the statusLine (the wrapper IS the statusLine via exec), so it gets
# the IDENTICAL EOF and returns. We deliberately do NOT add a per-render read timeout or
# a Node guard: that would reintroduce a per-render spawn (the exact pile-up this rewrite
# removes), to "fix" a hang the evidence above shows cannot happen. The test harness
# feeds a closing stdin to exercise this real EOF path.
tmp="$(mktemp 2>/dev/null)" || tmp="${TMPDIR:-/tmp}/cct.$$"
cat > "$tmp"

# Telemetry dir: CCT_DIR override, else ~/.claude/cc-context-telemetry. Mirror
# index.js telemetryDir(). HOME may be unset in odd environments; tolerate it.
dir="${CCT_DIR:-${HOME:-/tmp}/.claude/cc-context-telemetry}"

# Extract the TOP-LEVEL "session_id" string in pure shell. Bounded: a single
# non-greedy sed over one line of the (small) payload. Sanitize to [A-Za-z0-9_-] so a
# hostile id cannot escape the dir, then mirror index.js sanitizeId so a reader
# resolves the same filename: every char outside [A-Za-z0-9_-] becomes "_", and an
# empty result falls back to "default" (NOT "shared" - the JS reader's empty-id
# fallback is "default"; they must agree or a hook read would miss the file). For a
# real session_id (an ASCII UUID: hex + hyphens) shell `tr` (byte-wise) and JS regex
# (code-unit) agree EXACTLY. An exotic non-ASCII id may map to a different name in the
# two (tr counts bytes, JS counts UTF-16 units), but BOTH stay contained inside the
# dir - the worst case is a fail-safe read-miss, never a path escape.
sid="$(sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$tmp" 2>/dev/null | head -n 1)"
sid="$(printf '%s' "$sid" | tr -c 'A-Za-z0-9_-' '_' )"
[ -n "$sid" ] || sid="default"

# Write the RAW payload for on-demand parsing by the consumer. Per session, so the
# file count is bounded by live sessions (the reader prunes stale ones, see
# index.js). Best-effort: a failed mkdir/write must never break the bar.
#
# ATOMIC: write to a temp file IN THE SAME DIR, then `mv` (rename) over the final
# name. POSIX rename within a filesystem is atomic, so a concurrent on-demand reader
# sees either the old complete file or the new complete file, never a half-written
# one. (cp alone writes in place and a reader could catch a partial file; the reader
# tolerates that by returning null on a parse error, but the atomic rename removes
# the race entirely.) The temp uses $$ so concurrent renders for the SAME session do
# not clobber each other's temp; the final rename is last-writer-wins, which is
# correct (newest render's payload wins).
mkdir -p "$dir" 2>/dev/null || true
raw_final="$dir/telemetry-raw-$sid.json"
raw_tmp="$dir/.telemetry-raw-$sid.$$.tmp"
if cp "$tmp" "$raw_tmp" 2>/dev/null; then
  mv -f "$raw_tmp" "$raw_final" 2>/dev/null || rm -f "$raw_tmp" 2>/dev/null || true
fi

# Build the telemetry SEGMENT: "ctx X% | 5h Y% ~cd | 7d Z% ~cd" in cheap pure shell.
# Shown PREPENDED in WRAP mode and as the whole bar in STANDALONE. No emoji (project rule).
# Never blank. Cosmetic and fail-soft; the AUTHORITATIVE parse is index.js (real JSON.parse).
#
# ctx (context %) and the model token are PER SESSION: they come only from THIS render's
# payload ($tmp).
#
# 5h/7d are ACCOUNT-WIDE. Claude Code refreshes rate_limits only when a session makes an API
# call, so different open sessions disagree: a session that has not called recently keeps
# reporting its OLD reading. The picker below ranks the readings per window (see consider()),
# among those whose own reset is still in the FUTURE:
#   5h: (resets_at DESC, then used_percentage DESC)
#   7d: (resets_at DESC, then the reading OWN five_hour resets_at DESC as a CLOCK, then
#        used_percentage DESC)
#
# WHY. Both windows are FIXED-window quotas (verified against live payloads: 7d resets_at sits
# on a 604800s grid and every concurrent session shares the identical current boundary), so a
# LATER resets_at is always the newer window and a pre-reset high carries an OLD boundary that
# has since ELAPSED and is excluded by consider() (r <= now). That handles a NORMAL reset.
#
# But used_percentage DESC is NOT a safe freshness order on its own. It assumes account usage
# only ever GROWS within one boundary, and that assumption is FALSE in production: on 2026-09-05
# the 7d quota was reset WITHOUT the weekly boundary moving (same resets_at 1788811200: one
# session payload still reported 48%, live sessions reported 2% then 8%). "Highest used% wins"
# then locks the bar onto the STALEST pre-reset reading for the rest of the week, because a 7d
# boundary stays in the future for days and the elapsed-exclusion above never fires.
#
# So DATE each 7d reading instead of trusting its magnitude. A tracker line is written from ONE
# payload per render, so its 5h pair and its 7d pair ALWAYS come from the SAME API response, and
# the 5h reset epoch therefore timestamps the WHOLE line:
#   - five_hour resets_at never moves backwards, and successive 5h windows are at least 5h apart
#     (verified 2026-09-05 over 76 days of live pool data: every gap between consecutive distinct
#     boundaries is >= 18000s, the smallest exactly 18000s). A reading with boundary R was
#     measured in (R - 5h, R], so those intervals cannot overlap and a LATER 5h boundary means a
#     STRICTLY LATER measurement.
#   - it is ACCOUNT-WIDE, not per session (same data: a single boundary is carried identically by
#     up to 3 concurrent sessions, and no two readings have overlapping measurement intervals - a
#     per-session window would produce both). If it were per session this ordering would be
#     meaningless. Single account, single machine: that is the evidence available here, not a
#     guarantee about every account. Counts grow as sessions render, so they are not restated.
#   - a reading whose 5h boundary already elapsed is therefore KNOWN to predate one whose 5h
#     boundary is still ahead. Whenever any session holds a current-window reading, that bounds
#     7d staleness to the current 5h window instead of a whole 7d window; when the account has
#     been idle past its boundary, every reading is elapsed-dated and the clock still orders
#     them, so the freshest one that exists wins.
# Only when two readings carry the SAME 5h clock does used% decide, which preserves the
# 24%-vs-96% behaviour (a stale-low 7d must not beat the true high). KNOWN RESIDUAL: two readings
# that straddle a mid-window reset INSIDE one 5h window are indistinguishable here, so the
# stale-high one wins until some session records a reading in a LATER 5h window. Under continued
# use that is at most ~5h, but it takes an API call, so while every session sits idle the two
# clocks elapse together, the order never changes, and the stale high can hold for the rest of
# the 7d window - the same bound as before this rule (which is the honest statement: inside one
# 5h window this rule is no worse and no better). Ranking those by 5h used% would separate them,
# but only by assuming 5h usage never drops mid-window - the exact assumption this comment
# documents as falsified for 7d - and it would then invert the pick whenever a 5h quota is reset
# mid-window. Not worth it.
# PRECONDITION: the dating works because live payloads carry five_hour alongside seven_day
# (verified 2026-09-05 over every parseable raw payload on this machine: each carries BOTH
# windows or NEITHER, none carries one without the other, and no five_hour lacks a numeric
# resets_at). A reading with no/implausible/beyond-horizon 5h reset is UNDATED, ranks below every
# dated reading, and if NO reading in the pool is dated the 7d rank degrades to the plain used%
# order above. The one case where that is WORSE than the old order: if the FRESHEST reading were
# the undated one it would lose to a stale dated one and the bar would UNDERSTATE the quota. That
# needs a payload with seven_day but no usable five_hour, which has never been observed here; it
# is pinned by a test rather than guarded, because a separate candidate track for undated lines
# would add state to the one code path that has caused every regression in this picker.
#
# A per-session tracker file (telemetry-rl-<sid>) still records WHEN each window last CHANGED,
# but that change-TS is NOT a ranking key: an actively-used session whose Claude Code payload is
# stale restamps a fresh TS onto an OLD reading, so "newest change-TS wins" let a stale-low
# reading win the account-wide pick (the 24%-vs-96% bug). The TS is kept only as a corruption
# guard (a FUTURE stamp drops the entry).
#
# now comes from CCT_NOW when set (a deterministic test seam, unused in production) else
# `date +%s`; countdown is a pure DURATION so no timezone math. now must be valid for the
# change tracker to stamp a TS and for the account-wide picker to run.
now="${CCT_NOW:-$(date +%s 2>/dev/null)}"
case "$now" in ""|*[!0-9]*) now="" ;; esac

# Which segments to show, and in what ORDER (CCT_SEGMENTS, comma or space separated).
# Tokens: ctx, 5h, 7d, model. Order = display order; presence = shown. Unknown tokens are
# ignored; unset or empty falls back to the default. This is the only knob for the layout.
segs="${CCT_SEGMENTS:-ctx,5h,7d,model}"

# PHASE 1: extract THIS render's rate_limit reading as "5U|5R|7U|7R" (raw used_percentage +
# reset epoch for five_hour|seven_day, empty string for an absent field), reusing the SAME
# objspan/up/resetsat parse the segment awk uses. One awk over just this payload.
cur="$(LC_ALL=C awk '
  function objspan(key,   p, i, n, depth, start, c) {
    p = index(J, "\"" key "\"")
    if (p == 0) return ""
    n = length(J); i = p
    while (i <= n && substr(J, i, 1) != "{") i++
    if (i > n) return ""
    start = i; depth = 0
    while (i <= n) {
      c = substr(J, i, 1)
      if (c == "{") depth++
      else if (c == "}") { depth--; if (depth == 0) return substr(J, start + 1, i - start - 1) }
      i++
    }
    return ""
  }
  function up(key,   t) {
    t = objspan(key)
    if (t == "") return ""
    gsub(/\{[^{}]*\}/, "", t)
    if (match(t, /"used_percentage"[ \t]*:[ \t]*[0-9]+(\.[0-9]+)?/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*:[ \t]*/, "", t); return t
  }
  function resetsat(key,   t) {
    t = objspan(key)
    if (t == "") return ""
    gsub(/\{[^{}]*\}/, "", t)
    if (match(t, /"resets_at"[ \t]*:[ \t]*[0-9]+/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*:[ \t]*/, "", t); return t
  }
  { J = J $0 }
  END { printf "%s|%s|%s|%s", up("five_hour"), resetsat("five_hour"), up("seven_day"), resetsat("seven_day") }
' "$tmp" 2>/dev/null)"

# PHASE 2: update THIS session's change tracker BEFORE the picker scans, so the current
# reading is represented. The tracker is a single line "TS5|5U|5R|TS7|7U|7R" with a SEPARATE
# change timestamp PER WINDOW: rate_limits change only on an API call, and the two windows can
# change independently, so each window keeps its OWN "last changed" stamp. Stamp TS5/TS7 = now
# ONLY for the window whose reading actually differs from what we stored (a byte-identical
# window KEEPS its old TS - it did not change); the untouched window's TS is preserved verbatim.
# A shared single TS was a bug: 5h churn would restamp the whole line and make a STALE 7d in
# that same line look freshest, letting it win the account-wide pick with a stale countdown.
# No rate_limits at all (cur == "|||") or an empty extraction: nothing to track. Requires a
# valid now. Atomic write (temp in the same dir + mv), the same pattern as the raw write; the
# "." prefix + $$ keeps concurrent renders from clobbering and keeps the temp out of the picker
# glob (no dotfiles). MIGRATION: an old 5-field line "TS|5U|5R|7U|7R" is read as 6 fields (p6
# empty), so its stored 7d pair mismatches this render's and the line is rewritten in the new
# format on the next render; in the interim the picker parses its a[4..6] as a bogus 7d that
# consider() rejects (empty resets_at), so an old-format stale 7d can never win.
rl_final="$dir/telemetry-rl-$sid"
case "$cur" in
  ''|'|||') : ;;
  *)
    if [ -n "$now" ]; then
      # Split THIS render's reading "5U|5R|7U|7R" into per-window pairs cur5="5U|5R" and
      # cur7="7U|7R" using pure parameter expansion (no extra process).
      cur_rest="${cur#*|}"; cur_5u="${cur%%|*}"; cur_5r="${cur_rest%%|*}"
      cur_7r="${cur##*|}"; cur_mid="${cur%|*}"; cur_7u="${cur_mid##*|}"
      cur5="$cur_5u|$cur_5r"; cur7="$cur_7u|$cur_7r"
      p1=""; p2=""; p3=""; p4=""; p5=""; p6=""; have=0
      if [ -f "$rl_final" ] && [ -r "$rl_final" ]; then
        have=1
        # Split the stored line on "|" into its 6 fields. `|| :` keeps the partial content on
        # a no-trailing-newline EOF (our writer emits no trailing newline). IFS is scoped to
        # this one `read` (a prefix assignment) so it does not leak.
        IFS='|' read -r p1 p2 p3 p4 p5 p6 < "$rl_final" 2>/dev/null || :
      fi
      prev5="$p2|$p3"; prev7="$p5|$p6"
      if [ "$have" -eq 0 ] || [ "$cur5" != "$prev5" ] || [ "$cur7" != "$prev7" ]; then
        # Per-window TS: restamp only the window that changed; keep the other's stored TS.
        if [ "$have" -eq 0 ] || [ "$cur5" != "$prev5" ]; then ts5="$now"; else ts5="$p1"; fi
        if [ "$have" -eq 0 ] || [ "$cur7" != "$prev7" ]; then ts7="$now"; else ts7="$p4"; fi
        rl_tmp="$dir/.telemetry-rl-$sid.$$.tmp"
        if printf '%s|%s|%s|%s' "$ts5" "$cur5" "$ts7" "$cur7" > "$rl_tmp" 2>/dev/null; then
          mv -f "$rl_tmp" "$rl_final" 2>/dev/null || rm -f "$rl_tmp" 2>/dev/null || true
        fi
      fi
    fi
    ;;
esac

# PHASE 3 pool: every session's change tracker (telemetry-rl-*) in this CCT_DIR. Same safe
# glob + readable/regular-file filter as the old raw pool: a dir, dangling symlink, or
# unreadable entry matching the glob is SKIPPED, never fatal (awk FATALs on a file it cannot
# open, which would blank the whole segment). The list is CLEARED after the awk so CCT_WRAP
# never inherits these paths as its argv.
set -- "$dir"/telemetry-rl-*
[ -e "$1" ] || set --
n=$#
while [ "$n" -gt 0 ]; do
  f=$1; shift
  [ -f "$f" ] && [ -r "$f" ] && set -- "$@" "$f"
  n=$((n - 1))
done

# PHASE 3 awk. ctx + model + the per-session FALLBACK usage come from THIS render's payload
# ($tmp, passed FIRST and identified by -v tmpf). 5h/7d come from the account-wide picker
# over the tracker pool: for EACH window independently, among tracker entries that HAVE that
# window, whose resets_at is a plausible epoch (>=1e9, <1e11) and within the window horizon
# (5h: <= now+21600 ; 7d: <= now+691200), take the best-ranked one (5h: resets_at then used;
# 7d: resets_at, then the own-line five_hour resets_at as a freshness clock, then used - see
# consider()). No valid entry (or now invalid) -> fall back to THIS session own usage with NO
# countdown. LC_ALL=C makes awk byte-wise (the model-id whitelist strips all high/C1 bytes;
# numbers use a "." decimal regardless of locale). countdown() is UNCHANGED.
seg="$(LC_ALL=C awk -v now="$now" -v tmpf="$tmp" -v segs="$segs" '
  function objspan(key,   p, i, n, depth, start, c) {
    p = index(J, "\"" key "\"")
    if (p == 0) return ""
    n = length(J); i = p
    while (i <= n && substr(J, i, 1) != "{") i++
    if (i > n) return ""
    start = i; depth = 0
    while (i <= n) {
      c = substr(J, i, 1)
      if (c == "{") depth++
      else if (c == "}") { depth--; if (depth == 0) return substr(J, start + 1, i - start - 1) }
      i++
    }
    return ""
  }
  function up(key,   t) {
    t = objspan(key)
    if (t == "") return ""
    gsub(/\{[^{}]*\}/, "", t)
    if (match(t, /"used_percentage"[ \t]*:[ \t]*[0-9]+(\.[0-9]+)?/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*:[ \t]*/, "", t); return t
  }
  function rnd(v) { if (v == "") return ""; return int(v + 0.5) }
  # The model id STRING from the model object. Unlike every other field this is display text,
  # so it is SANITIZED before it can reach the terminal (strip control chars = defuse
  # ANSI/escape injection; strip spaces and "|" so a weird id cannot break the layout).
  function modelid(   t) {
    t = objspan("model")
    if (t == "") return ""
    if (match(t, /"id"[ \t]*:[ \t]*"[^"]*"/) == 0) return ""
    t = substr(t, RSTART, RLENGTH); sub(/.*"id"[ \t]*:[ \t]*"/, "", t); sub(/".*/, "", t)
    gsub(/[^]A-Za-z0-9._[-]/, "", t)   # WHITELIST: only safe display chars survive
    return t
  }
  # Short friendly model token: drop the "claude-" prefix and dot the version (digit-hyphen-
  # digit becomes digit-dot-digit), so claude-opus-4-8[1m] -> opus-4.8[1m]. No lookup table.
  function friendlymodel(   m) {
    m = modelid()
    if (m == "") return ""
    sub(/^claude-/, "", m)
    while (match(m, /[0-9]-[0-9]/)) m = substr(m, 1, RSTART) "." substr(m, RSTART + 2)
    return m
  }
  # Compact "~time-left" from an absolute reset epoch. Two units max; trailing unit shown
  # only when non-zero; "~<1m" under a minute. The "~now" branch (sec <= 0) is DEAD from the
  # picker path - consider() excludes r <= now - kept only as defense in depth; the bar can
  # never render "~now". Omits when now/resets_at missing, resets_at not a plausible epoch
  # (< 1e9), or the gap exceeds maxsec.
  function countdown(rsat, maxsec,   sec, d, h, m) {
    if (rsat == "" || now == "") return ""
    if (rsat + 0 < 1000000000) return ""
    sec = rsat - now
    if (sec > maxsec) return ""
    if (sec <= 0) return "~now"
    if (sec < 60) return "~<1m"
    if (sec < 3600) return "~" int(sec/60) "m"
    if (sec < 86400) { h = int(sec/3600); m = int((sec%3600)/60); return (m == 0) ? ("~" h "h") : ("~" h "h" m "m") }
    d = int(sec/86400); h = int((sec%86400)/3600); return (h == 0) ? ("~" d "d") : ("~" d "d" h "h")
  }
  # Rank one tracker entry into the per-window freshest. 5h: (resets_at DESC, used DESC). 7d:
  # (resets_at DESC, then the SAME line five_hour resets_at as a freshness clock - cr - then
  # used DESC). Guards: value present, resets_at a plausible epoch, reset in the FUTURE and
  # within the window horizon (elapsed/corrupt/far-future readings can never win), and the
  # change-TS not in the future (a corrupt/forward-clock tracker is dropped). See the block
  # comment above for why the 7d rank needs the 5h clock: a mid-window quota reset makes
  # "highest used% wins" pick the stalest reading, for days.
  function consider(win, ts, u, rsat, cr,   r, t, cap, o) {
    if (u == "" || rsat == "") return
    r = rsat + 0
    if (r < 1e9 || r >= 1e11) return
    cap = (win == 5) ? 21600 : 691200
    # resets_at must be in the FUTURE and within the window horizon: (now, now+cap]. A valid
    # current reading always has a future reset boundary; a reset that already ELAPSED means
    # that reading predates the last window reset (stale - the window has since reset), so
    # exclude it even if its change-TS is recent (an anomalous session can restamp a fresh TS
    # while still reporting an old, already-passed reset). This also stops the display from
    # showing a misleading "~now" sourced from a stale reading.
    if (now != "" && (r <= now || r > now + cap)) return
    t = ts + 0
    # The change-TS is no longer the ranking key, but a FUTURE TS still signals a corrupt
    # tracker or a forward clock jump, so drop it (> now + 60s slack for same-machine render
    # jitter). A tiny/non-numeric TS coerces low and is harmless.
    if (now != "" && t > now + 60) return
    # 5h: newest window first (max resets_at), then within one window the later sample (max
    # used). u/u5 are numeric-coerced for the compare (used_percentage can be a float).
    if (win == 5) { if (!h5 || r > r5 || (r == r5 && u + 0 > u5 + 0)) { u5 = u; r5 = r; h5 = 1 }; return }
    # 7d: newest window first, then the own-line 5h reset epoch as the freshness clock (o), then
    # used. o = 0 marks an UNDATED line: a missing, non-numeric or sub-epoch 5h reset (the
    # o < 1e9 test, which "" and garbage also fail), or one beyond the clock horizon, which is
    # how a corrupt far-future epoch (including a 1e12 milliseconds misparse) is stopped from
    # pinning the pick. Undated lines rank below every dated one and only tie among themselves,
    # where the used% order decides, so an undated reading can still be shown when nothing better
    # exists. The clock horizon is a DAY, deliberately far looser than the 5h window it dates: a
    # real boundary is at most one window out (5h on every plan seen here, and a looser horizon
    # is what keeps this honest if some plan uses a longer one), but the LOCAL clock can run slow
    # (VM resume, bad NTP), and marking a genuinely FRESH reading undated is the worse error - it
    # hands the pick to the stale readings that are still dated, which is the 24%-vs-96%
    # inversion. A day tolerates about 19h of slow clock while still rejecting anything that is
    # not a window boundary at all. The cost, stated plainly: values in (now+21600, now+86400]
    # are refused as a 5h BOUNDARY by the 5h picker above yet accepted here as a CLOCK, and since
    # the clock tier is a maximum, one such line outranks every genuine reading on its boundary.
    # A slow clock does put GENUINE lines in that band (that is the case this tolerance exists
    # for), but it shifts every line equally, so it cannot invert an ordering; only a corrupt or
    # foreign line lands there while the others do not, and that is the one way the band can rank
    # something wrongly. This tolerance applies to the 7d RANK only: the 5h pick above keeps the
    # 21600 cap, because that cap also bounds what the 5h countdown may display, so under a slow
    # clock the 5h segment can still show a stale reading (a 5h window self-heals within 5h; a 7d
    # one does not, which is why only the 7d rank is widened).
    # (The now != "" test is defensive only: with no valid now the END block discards the pick.)
    o = cr + 0
    if (o < 1e9 || (now != "" && o > now + 86400)) o = 0
    if (!h7 || r > r7 || (r == r7 && (o > o7 || (o == o7 && u + 0 > u7 + 0)))) {
      u7 = u; r7 = r; o7 = o; h7 = 1
    }
  }
  # Tracker files are single-line "TS5|5U|5R|TS7|7U|7R" with a per-window change TS; parse the
  # FIRST line of each. THIS render payload ($tmp) is JSON, accumulated into J for the
  # per-session values instead. An old 5-field line self-migrates (see the writer): read here
  # its a[6] is empty, so its 7d reading (a[5], a[6]) has an empty resets_at and consider()
  # rejects it - an old-format stale 7d can never win in the interim before the rewrite.
  FNR == 1 && FILENAME != tmpf { split($0, a, "|"); consider(5, a[1], a[2], a[3]); consider(7, a[4], a[5], a[6], a[3]) }
  FILENAME == tmpf { J = J $0 }
  END {
    ctx = rnd(up("context_window")); f5 = rnd(up("five_hour")); f7 = rnd(up("seven_day"))
    # Cross-session ranked value only when now is known (else the horizon guard is off) - else
    # fall back to THIS session own usage with no countdown.
    ctxseg = (ctx == "") ? "ctx --" : ("ctx " ctx "%")
    if (now != "" && h5) { fivehseg = "5h " rnd(u5) "%"; cd = countdown(r5, 21600); if (cd != "") fivehseg = fivehseg " " cd }
    else if (f5 != "")   { fivehseg = "5h " f5 "%" }
    if (now != "" && h7) { sevendseg = "7d " rnd(u7) "%"; cd = countdown(r7, 691200); if (cd != "") sevendseg = sevendseg " " cd }
    else if (f7 != "")   { sevendseg = "7d " f7 "%" }
    modelseg = friendlymodel()
    # Assemble in the CCT_SEGMENTS order, joining the present segments with " | ".
    k = split(segs, arr, /[ ,]+/)
    out = ""
    for (i = 1; i <= k; i++) {
      p = ""
      if (arr[i] == "ctx") p = ctxseg
      else if (arr[i] == "5h") p = fivehseg
      else if (arr[i] == "7d") p = sevendseg
      else if (arr[i] == "model") p = modelseg
      if (p != "") out = (out == "") ? p : (out " | " p)
    }
    # Never-blank fallback that RESPECTS CCT_SEGMENTS: if nothing assembled (e.g. ctx not
    # requested and the pinned window has nothing to show), emit "<label> --" for the FIRST
    # requested token that is one of ctx/5h/7d - never a "ctx --" the user deliberately
    # excluded. If the list names none of those (e.g. only "model"), emit a bare "--". The
    # shell-level seg="ctx --" below stays ONLY as the defense for a fatally-failed awk that
    # emits no output at all.
    if (out == "") {
      for (i = 1; i <= k; i++) {
        if (arr[i] == "ctx") { out = "ctx --"; break }
        else if (arr[i] == "5h") { out = "5h --"; break }
        else if (arr[i] == "7d") { out = "7d --"; break }
      }
      if (out == "") out = "--"
    }
    printf "%s", out
  }
' "$tmp" "$@" 2>/dev/null)"
[ -n "$seg" ] || seg="ctx --"

# Clear the positional params (the account-wide file pool) so the CCT_WRAP command below,
# run via `eval exec`, does NOT inherit these file paths as its argv ($@ / $1 / $#).
set --

# WRAP mode: PRINT our telemetry segment, then EXEC the wrapped statusline so its bar
# appends on the SAME line ("ctx 66% | 5h 12% | 7d 30% <wrapped bar>"). Printing BEFORE
# exec preserves the no-orphan property: the wrapped command still BECOMES the process
# Claude Code kills (no spawn, no detach, no per-render Node). The segment is emitted
# from a subshell so its bytes are FLUSHED to stdout before exec hands the fd to the
# wrapped command (a plain builtin printf can sit in the shell output buffer that exec
# would discard). That subshell is one cheap, synchronously-reaped fork, like the awk
# calls above - not a lingering process.
#
# We do NOT route through `sh -c "$CCT_WRAP"` (which may FORK and leave an orphan on a
# per-render kill), and we NEVER detach. Do NOT background your statusLine with a
# trailing `&`: a statusLine that backgrounds a helper outliving the front pid leaks it
# on every render-kill - IDENTICALLY under direct use and under this wrapper (exec makes
# the wrapped command BECOME the killed process, so the tree matches direct; the leak is
# the forking statusline's own foot-gun, not the wrapper's). test/loadrepro proves this
# (forking callee run both ways: FDIR == FWRP).
if [ -n "${CCT_WRAP:-}" ] && [ -n "$(printf '%s' "${CCT_WRAP:-}" | tr -d '[:space:]')" ]; then
  ( printf '%s ' "$seg" )
  exec 3< "$tmp"
  rm -f "$tmp"
  # `eval` parses a quoted command string ("'/path/adtention' status"); `exec` replaces
  # THIS shell with it so it becomes the killed process. A missing command exits 127
  # (the segment still printed); we NEVER spawn a fallback.
  eval "exec ${CCT_WRAP} <&3"
  exit 0
fi

# STANDALONE mode (no CCT_WRAP): the telemetry segment IS the whole bar.
rm -f "$tmp"
printf '%s' "$seg"
exit 0
